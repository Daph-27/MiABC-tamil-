{
  "id": "01_alphabet",
  "title": "Foundational Alphabet - Tamil & English",
  "description": "Master 8-10 core sounds in each language with parallel learning",
  "level": "foundational",
  "weeks": [
    {
      "weekNumber": 1,
      "weekTitle": "Vowel Foundation (Both Languages)",
      "days": [
        {
          "day": 1,
          "focus": "Tamil அ + English A",
          "description": "Begin with vowels that have close English equivalents"
        },
        {
          "day": 2,
          "focus": "Tamil இ + English I",
          "description": "Front vowels with similar sounds"
        },
        {
          "day": 3,
          "focus": "Tamil உ + English U",
          "description": "Back vowels - establishing foundation"
        }
      ]
    },
    {
      "weekNumber": 2,
      "focus": "English E, O + Review",
      "description": "Complete English foundational vowels"
    },
    {
      "weekNumber": 3,
      "focus": "Consonants with Direct Parallels (M, P, T, N)",
      "description": "Introduce 2 consonants per week in both languages"
    },
    {
      "weekNumber": 4,
      "focus": "Consonants with Direct Parallels (L, R)",
      "description": "Continue parallel consonant instruction"
    },
    {
      "weekNumber": 5,
      "focus": "Unique Sounds (Tamil ய், English S, B)",
      "description": "Introduce sounds unique to each language"
    }
  ],
  "tabs": [
    "Tamil Vowels",
    "English Vowels",
    "Tamil Consonants",
    "English Consonants",
    "Parallel Sounds"
  ],
